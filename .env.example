# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
# .env is git-ignored. Never commit real keys or personal data.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# From the backend container, MongoDB is reached by its Compose service name.
MONGODB_URI=mongodb://mongodb:27017/job_agent

# OpenRouter (backend only -- never exposed to the React app)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Personal Job Agent

# AI behaviour
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_INPUT_CHARS=24000

# Documents are mounted read-only into the backend container.
DOCUMENTS_PATH=/app/documents
MAX_DOCUMENT_SIZE_MB=10

# Application safety. Keep approval required unless you fully understand the risks.
APPROVAL_REQUIRED=true

# Browser origins allowed to call the API (comma-separated).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=info

# Optional scheduler inside the API process (the dedicated worker service is preferred).
SCHEDULER_ENABLED=false

# The mock job source is for local testing only. It never contacts a real employer.
ENABLE_MOCK_SOURCE=true

# Only mock-source applications can be "submitted" without a real integration.
# This is simulated and clearly labelled in the UI. Leave false for real use.
ALLOW_MOCK_SUBMISSION=false

# Optional: bind MongoDB to the host for debugging with mongosh.
# Keep it on 127.0.0.1 and never expose it publicly.
MONGO_HOST_PORT=127.0.0.1:27017
